{
  "name": "document-chat-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Answers questions about a set of documents, and knows when a vector search is the wrong tool for the question it was asked.",
  "author": "Riccardo Sapuppo",
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "measure": "node tools/measure.mjs",
    "check:serving": "node tools/how-it-is-served.mjs",
    "check:screen": "node tools/through-the-screen.mjs",
    "check:mark": "node tools/check-mark.mjs",
    "screenshots": "node tools/screenshots.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "playwright-core": "^1.62.1"
  }
}
